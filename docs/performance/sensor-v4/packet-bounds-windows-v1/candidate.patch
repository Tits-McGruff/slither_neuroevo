+            (point(0.0, 0.0), 0.0, 0.0, Some(0.0)),
+            (point(-10.0, 3.0), -0.0, 9.0, Some(9.0)),
+            (point(-10.0, 3.0_f64.next_up()), 0.0, 100.0, None),
+            (point(-10.0, 0.0), 0.0, 9.0_f64.next_down(), None),
+        ] {
+            let ray = SensorRay::new(origin, heading, maximum).unwrap();
+            assert_eq!(bounds.clearance(ray), expected);
+        }
+        // Inflation may legitimately extend the validated input box's coordinates.
+        let wide = InflatedSensorAabb::new(
+            point(-GEOMETRY_BOUND, -GEOMETRY_BOUND),
+            point(GEOMETRY_BOUND, GEOMETRY_BOUND),
+            GEOMETRY_BOUND,
+        )
+        .unwrap();
+        assert_eq!(
+            wide.clearance(SensorRay::new(point(GEOMETRY_BOUND, 0.0), 0.0, 0.0).unwrap()),
+            Some(0.0)
+        );
+    }
