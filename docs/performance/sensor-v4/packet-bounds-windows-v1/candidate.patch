+    #[test]
+    fn packet_envelope_preserves_closed_ranges_and_subtraction_cancellation() {
+        let rays = [
+            SensorRay::new(point(0.0, 0.0), 0.0, 10.0).unwrap(),
+            SensorRay::new(point(0.0, 0.0), std::f64::consts::FRAC_PI_2, 5.0).unwrap(),
+        ];
+        let envelope = RayPacketEnvelope::new(&rays).unwrap();
+        let behind = InflatedSensorAabb::new(point(-3.0, -1.0), point(-2.0, 1.0), 0.0).unwrap();
+        assert!(envelope.excludes(&behind, 3));
+        let far = InflatedSensorAabb::new(point(11.0, -1.0), point(12.0, 1.0), 0.0).unwrap();
+        assert!(envelope.excludes(&far, 3));
+        let edge = InflatedSensorAabb::new(point(10.0, 0.0), point(10.0, 0.0), 0.0).unwrap();
+        assert!(!envelope.excludes(&edge, 1));
+        assert_eq!(edge.clearance(rays[0]), Some(10.0));
+        // Forming origin + maximum would incorrectly reject this legacy slab hit.
+        let ray = SensorRay::new(point(-500.0, 0.0), 0.0, 500.0).unwrap();
+        let near_edge = InflatedSensorAabb::new(point(5e-15, -1.0), point(5.0, 1.0), 0.0).unwrap();
+        assert!(!RayPacketEnvelope::new(&[ray])
+            .unwrap()
+            .excludes(&near_edge, 1));
+        assert_eq!(near_edge.clearance(ray), Some(500.0));
+        assert!(RayPacketEnvelope::new(&[rays[0], ray]).is_none());
+    }
