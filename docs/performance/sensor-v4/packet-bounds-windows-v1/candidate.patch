+/// Validated, inflated bounds reused across a packet without repeating public checks.
+/// Private coordinates can exceed GEOMETRY_BOUND only by the validated inflation,
+/// exactly as the original slab calculation; no ray origin or direction is cached.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct InflatedSensorAabb {
+    minimum: WorldPoint,
+    maximum: WorldPoint,
+}
+impl InflatedSensorAabb {
+    pub(crate) fn new(
+        minimum: WorldPoint,
+        maximum: WorldPoint,
+        inflation: f64,
+    ) -> Result<Self, SensorGeometryError> {
+        if !valid_point(minimum)
+            || !valid_point(maximum)
+            || minimum.x > maximum.x
+            || minimum.y > maximum.y
+            || !valid_nonnegative(inflation)
+        {
+            return Err(SensorGeometryError);
+        }
+        Ok(Self {
+            minimum: WorldPoint {
+                x: minimum.x - inflation,
+                y: minimum.y - inflation,
+            },
+            maximum: WorldPoint {
+                x: maximum.x + inflation,
+                y: maximum.y + inflation,
+            },
+        })
+    }
+
+    /// Preserve the original two-axis divisions and closed-boundary comparisons.
+    #[inline]
+    pub(crate) fn clearance(&self, ray: SensorRay) -> Option<f64> {
+        let mut enter: f64 = 0.0;
+        let mut exit = ray.maximum;
+        for (origin, delta, low, high) in [
+            (
+                ray.origin.x,
+                ray.direction.x,
+                self.minimum.x,
+                self.maximum.x,
+            ),
+            (
+                ray.origin.y,
+                ray.direction.y,
+                self.minimum.y,
+                self.maximum.y,
+            ),
+        ] {
+            if delta == 0.0 {
+                if origin < low || origin > high {
+                    return None;
+                }
+            } else {
+                let first = (low - origin) / delta;
+                let last = (high - origin) / delta;
+                enter = enter.max(first.min(last));
+                exit = exit.min(first.max(last));
+                if enter > exit {
+                    return None;
+                }
+            }
+        }
+        Some(enter)
+    }
+}
+
+/// Common-origin packet facts used only for conservative whole-packet rejection.
+/// The fallback handles heterogeneous origins or unsupported direction components.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct RayPacketEnvelope {
+    origin: WorldPoint,
+    maximum: f64,
+    positive_x: u32,
+    negative_x: u32,
+    positive_y: u32,
+    negative_y: u32,
+}
+impl RayPacketEnvelope {
+    pub(crate) fn new(rays: &[SensorRay]) -> Option<Self> {
+        let origin = rays.first()?.origin;
+        if rays.len() > 32 || !valid_point(origin) {
+            return None;
+        }
+        let mut envelope = Self {
+            origin,
+            maximum: 0.0,
+            positive_x: 0,
+            negative_x: 0,
+            positive_y: 0,
+            negative_y: 0,
+        };
+        for (bin, ray) in rays.iter().enumerate() {
+            if ray.origin.x.to_bits() != origin.x.to_bits()
+                || ray.origin.y.to_bits() != origin.y.to_bits()
+                || !valid_nonnegative(ray.maximum)
+                || !(-1.0..=1.0).contains(&ray.direction.x)
+                || !(-1.0..=1.0).contains(&ray.direction.y)
+            {
+                return None;
+            }
+            let bit = 1u32 << bin;
+            envelope.maximum = envelope.maximum.max(ray.maximum);
+            if ray.direction.x > 0.0 {
+                envelope.positive_x |= bit;
+            }
+            if ray.direction.x < 0.0 {
+                envelope.negative_x |= bit;
+            }
+            if ray.direction.y > 0.0 {
+                envelope.positive_y |= bit;
+            }
+            if ray.direction.y < 0.0 {
+                envelope.negative_y |= bit;
+            }
+        }
+        Some(envelope)
+    }
+
+    /// Use the original slab numerators, avoiding endpoint-add cancellation.
+    /// A component's magnitude is at most one, so a positive gap beyond every
+    /// ray's parameter range cannot be recovered by its slab division. A gap
+    /// with no active direction toward it is also unreachable, including zero
+    /// components. Strict comparisons preserve the original closed edges.
+    #[inline]
+    pub(crate) fn excludes(&self, bounds: &InflatedSensorAabb, active: u32) -> bool {
+        for (lower, upper, positive, negative) in [
+            (
+                bounds.minimum.x - self.origin.x,
+                bounds.maximum.x - self.origin.x,
+                self.positive_x,
+                self.negative_x,
+            ),
+            (
+                bounds.minimum.y - self.origin.y,
+                bounds.maximum.y - self.origin.y,
+                self.positive_y,
+                self.negative_y,
+            ),
+        ] {
+            if lower > self.maximum
+                || -upper > self.maximum
+                || (lower > 0.0 && active & positive == 0)
+                || (upper < 0.0 && active & negative == 0)
+            {
+                return true;
+            }
+        }
+        false
+    }
+}
