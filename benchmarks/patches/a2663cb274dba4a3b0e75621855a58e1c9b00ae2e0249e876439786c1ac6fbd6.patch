+/// Classify without evaluating a norm when a larger guard proves the same interior.
+/// Twice the largest normal component bounds the true hypot with ample rounding
+/// margin. The classifier's binary search is norm-independent; a larger guard can
+/// only decline an interior result. Ambiguous/subnormal/extreme cases use the
+/// original exact norm and v4 fallback before assigning a bucket.
+#[inline]
+fn sector_bin_by_components(
+    classifier: Option<&CenteredAngularBins>,
+    x: f64,
+    y: f64,
+    direction: f64,
+    bins: usize,
+) -> usize {
+    let largest = x.abs().max(y.abs());
+    let upper = 2.0 * largest;
+    if x.is_finite() && y.is_finite() && largest >= f64::MIN_POSITIVE && upper.is_finite() {
+        if let Some(bin) = classifier.and_then(|bins| bins.classify_interior(x, y, upper)) {
+            return bin;
+        }
+    }
+    sector_bin(classifier, x, y, x.hypot(y), direction, bins)
+}
