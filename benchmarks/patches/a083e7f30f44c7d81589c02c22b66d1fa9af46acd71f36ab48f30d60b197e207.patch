+/// Fixed stack storage for the common 900-candidate sensor detail limit.
+const PELLET_RADIX_CAPACITY: usize = 1024;
+
+/// Preserve exact distance/ordinal order; leave sparse and large queries on the
+/// existing comparison path. The radix path adds no owned or heap storage.
+fn sort_pellet_candidates(values: &mut [PelletCandidate]) {
+    if values.len() <= 128 || values.len() > PELLET_RADIX_CAPACITY {
+        values.sort_unstable_by(compare_pellet_candidates);
+    } else if values
+        .windows(2)
+        .all(|pair| compare_pellet_candidates(&pair[0], &pair[1]) != Ordering::Greater)
+    {
+        // Keep the comparison sort's adaptive behavior for already ordered data.
+    } else if values
+        .windows(2)
+        .all(|pair| compare_pellet_candidates(&pair[0], &pair[1]) != Ordering::Less)
+    {
+        values.reverse();
+    } else {
+        sort_pellet_candidates_buffered(values);
+    }
+}
+
+/// Keep the 16-KiB temporary frame out of sparse/large-query callers.
+#[inline(never)]
+fn sort_pellet_candidates_buffered(values: &mut [PelletCandidate]) {
+    let mut scratch = [PelletCandidate {
+        pellet: 0,
+        distance_squared: DistanceOrderKey(0),
+    }; PELLET_RADIX_CAPACITY];
+    sort_pellet_partitions(values, &mut scratch[..values.len()]);
+}
+
+/// Stable scatter avoids random swaps. Shared leading bits are skipped; every
+/// child fixes four more bits, bounding nesting at sixteen partitions plus one
+/// comparison leaf. Equal-distance leaves retain the exact ordinal tie break.
+fn sort_pellet_partitions(values: &mut [PelletCandidate], scratch: &mut [PelletCandidate]) {
+    if values.len() <= 64 {
+        values.sort_unstable_by(compare_pellet_candidates);
+        return;
+    }
+    let first = values[0].distance_squared.0 as u64;
+    let differing = values.iter().fold(0, |bits, value| {
+        bits | (first ^ value.distance_squared.0 as u64)
+    });
+    if differing == 0 {
+        values.sort_unstable_by(compare_pellet_candidates);
+        return;
+    }
+    let shift = (63 - differing.leading_zeros()).saturating_sub(3);
+    let digit = |value: &PelletCandidate| {
+        (((value.distance_squared.0 as u64 ^ (1 << 63)) >> shift) & 15) as usize
+    };
+    let mut ends = [0usize; 16];
+    for value in values.iter() {
+        ends[digit(value)] += 1;
+    }
+    let mut next = [0usize; 16];
+    let mut offset = 0;
+    for bucket in 0..16 {
+        next[bucket] = offset;
+        offset += ends[bucket];
+        ends[bucket] = offset;
+    }
+    for value in values.iter() {
+        let bucket = digit(value);
+        scratch[next[bucket]] = *value;
+        next[bucket] += 1;
+    }
+    let mut start = 0;
+    for end in ends {
+        if end - start > 1 {
+            sort_pellet_partitions(&mut scratch[start..end], &mut values[start..end]);
+        }
+        start = end;
+    }
+    values.copy_from_slice(scratch);
 }
 
