+
+/// Preserve the exact (cached distance, pellet ordinal) order without a second buffer.
+///
+/// Large distance groups use in-place most-significant-nibble partitioning.
+/// Shared leading bits are skipped; small or equal-distance groups retain the
+/// comparison sort, including its exact ordinal tie break. Each recursive group
+/// fixes at least one more nibble: at most sixteen radix partitions plus one
+/// comparison leaf can nest. Candidate storage and worker admission are unchanged.
+fn sort_pellet_candidates(values: &mut [PelletCandidate]) {
+    const COMPARISON_LIMIT: usize = 64;
+    if values.len() <= COMPARISON_LIMIT {
+        values.sort_unstable_by(compare_pellet_candidates);
+        return;
+    }
+    let first = values[0].distance_squared.0 as u64;
+    let differing = values.iter().fold(0, |bits, value| {
+        bits | (first ^ value.distance_squared.0 as u64)
+    });
+    if differing == 0 {
+        values.sort_unstable_by(compare_pellet_candidates);
+        return;
+    }
+    let shift = (63 - differing.leading_zeros()) & !3;
+    let digit = |value: &PelletCandidate| {
+        // Bias the signed cached key into unsigned order; no float conversion.
+        (((value.distance_squared.0 as u64 ^ (1 << 63)) >> shift) & 15) as usize
+    };
+    let mut counts = [0usize; 16];
+    for value in values.iter() {
+        counts[digit(value)] += 1;
+    }
+    let mut ends = [0usize; 16];
+    let mut next = [0usize; 16];
+    let mut offset = 0;
+    for bucket in 0..16 {
+        next[bucket] = offset;
+        offset += counts[bucket];
+        ends[bucket] = offset;
+    }
+    for bucket in 0..16 {
+        while next[bucket] < ends[bucket] {
+            let target = digit(&values[next[bucket]]);
+            if target == bucket {
+                next[bucket] += 1;
+            } else {
+                // The histogram guarantees an unfilled target slot: every
+                // earlier filled slot contains its own digit, so an out-of-
+                // bucket item cannot belong to a bucket already at capacity.
+                values.swap(next[bucket], next[target]);
+                next[target] += 1;
+            }
+        }
+    }
+    let mut start = 0;
+    for end in ends {
+        if end - start > 1 {
+            sort_pellet_candidates(&mut values[start..end]);
+        }
+        start = end;
+    }
 }
 
