+  const bytes=await readFile(path);const actual=Buffer.from(await webcrypto.subtle.digest('SHA-256',bytes)).toString('hex');assert.equal(actual,JSON.parse(row.descriptor).sha256);completedBytes+=bytes.length;}
+ if(role==='serial')for(const row of rows){const path=join(root,row.filename);const metadata=lstatSync(path);assert(metadata.isFile()&&!metadata.isSymbolicLink());assert.equal(metadata.size,row.bytes);const bytes=readFileSync(path);assert.equal(createHash('sha256').update(bytes).digest('hex'),JSON.parse(row.descriptor).sha256);completedBytes+=bytes.length;}
