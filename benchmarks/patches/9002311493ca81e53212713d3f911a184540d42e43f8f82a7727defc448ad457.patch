+/// Enclose binary64 norm/strength/ordered-sum rounding before admitting a Float32.
+/// Queries retain at most 3,000 terms in [0,6], with saturation scale in [0.5,12].
+/// The 256-epsilon allowance per retained term dominates ordinary binary64 errors;
+/// endpoint padding also covers the saturation arithmetic. Uncertain encodings
+/// (including signed-zero crossings) always use the original hypot accumulation.
+fn food_rounding_is_stable(sum: f64, count: usize, scale: f64) -> bool {
+    let error = (count as f64 + 1.0) * (256.0 * f64::EPSILON) * (1.0 + sum);
+    let lower = (sum - error).max(0.0);
+    let upper = sum + error;
+    let encode = |value: f64| 2.0 * (value / (value + scale)).clamp(0.0, 1.0) - 1.0;
+    let padding = 16.0 * f64::EPSILON;
+    let low = ((encode(lower) - padding).max(-1.0)) as f32;
+    let high = ((encode(upper) + padding).min(1.0)) as f32;
+    low.to_bits() == high.to_bits()
+}
