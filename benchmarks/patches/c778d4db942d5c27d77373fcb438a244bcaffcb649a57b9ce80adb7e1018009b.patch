+    saved.write_text(json.dumps(data,indent=2)+'\n',encoding='utf-8')
+    pair[label]=data
+   before,after=pair['reference'],pair['candidate']
+   assert before['workload']==after['workload'],scenario
+   assert before['source']['nativeBuildContractSha256']==after['source']['nativeBuildContractSha256']
+   assert before['source']['rustcVersion']==after['source']['rustcVersion']
+   assert after['source']['nativeSourceSha256']=='b066380f41085a83f8aed9445a26475f569c78d72aedcde238a1580aed2f3925'
+   max_errors={}
