+    assert error<=before['result']['oneStepComparisonProbe']['absoluteTolerance'],(scenario,field,error)
+    max_errors[field]=error
+   records.append({'scenario':scenario,'pass':pass_number,'oldFirst':old_first,
+    'referenceMeanMs':before['result']['wholePopulationPassMs']['mean'],
+    'candidateMeanMs':after['result']['wholePopulationPassMs']['mean'],'maxProbeAbs':max_errors})
+ summary=[{'scenario':scenario,'medianCandidateRatio':statistics.median(x['candidateMeanMs']/x['referenceMeanMs'] for x in records if x['scenario']==scenario)} for scenario in ['P0','P1','P2','P3']]
+ report={'kind':'paired-native-population-inference-v1','referenceCommit':'589383adfb229ff46560c3820119ebca77374393',
+  'candidateCommit':'7b375bcf','referenceExecutableSha256':hashlib.sha256(reference.read_bytes()).hexdigest(),
