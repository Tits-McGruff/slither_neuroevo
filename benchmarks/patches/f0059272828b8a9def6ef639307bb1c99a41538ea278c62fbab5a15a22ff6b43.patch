+++ b/benchmarks/historical/run-study-f0059272828b.py
@@ -0,0 +1,96 @@
+"""Task-owned measured-study driver; starts only after the Windows soak succeeds."""
+from pathlib import Path
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import time
+
+SLITHER=Path(r"C:/Users/jlow8/source/repos/slither_neuroevo")
+PYRL=Path(r"C:/Users/jlow8/source/repos/PyRL-trainer")
+EXPECTED="df2de6c6144b1b3b69305c7149fc850ca761ba22"
+SOURCE="00c6adb838af9ddff8fa706a23f5854bff7905587bf40a730023a15ab0675689"
+ROOT=SLITHER/"native/target/replicated-ablation-windows-20261021"
+JOURNAL=SLITHER/"native/target/replicated-ablation-20261021.status.json"
+STARTED=time.monotonic()
+DEADLINE=STARTED+8*3600
+
+def journal(stage, **fields):
+    value={"schemaVersion":1,"stage":stage,"pyrlRevision":EXPECTED,
+           "slitherNativeSourceSha256":SOURCE,"elapsedSeconds":time.monotonic()-STARTED,**fields}
+    with JOURNAL.open("w",encoding="utf-8") as stream:
+        stream.write(json.dumps(value,indent=2)+"\n");stream.flush();os.fsync(stream.fileno())
+
+def capture(args,cwd):
+    return subprocess.check_output(args,cwd=cwd,text=True,creationflags=subprocess.CREATE_NO_WINDOW).strip()
+
+def frozen():
+    if capture(["git","rev-parse","HEAD"],PYRL)!=EXPECTED:
+        raise RuntimeError("trainer checkout changed before/during replicated study")
+    if capture(["git","status","--porcelain","--","pyrl_trainer"],PYRL):
+        raise RuntimeError("trainer package has uncommitted changes")
+    if capture(["git","status","--porcelain","--","native/src","native/build.rs","native/Cargo.toml","native/Cargo.lock"],SLITHER):
+        raise RuntimeError("native source changed before/during replicated study")
+
+def run(args,cwd,log,maximum):
+    remaining=DEADLINE-time.monotonic()
+    if remaining<=0:raise TimeoutError("replicated study total deadline")
+    with log.open("w",encoding="utf-8") as stream:
+        subprocess.run([str(value) for value in args],cwd=cwd,stdout=stream,stderr=subprocess.STDOUT,
+                       check=True,timeout=min(maximum,remaining),creationflags=subprocess.CREATE_NO_WINDOW)
+
+try:
+    frozen()
+    run(["node","node_modules/tsx/dist/cli.mjs","scripts/qualification/verify-soak.ts","--report",
+         "docs/performance/sensor-v4/continuous-soak-windows-v1/P0.json","--require-six-hours"],
+        SLITHER,SLITHER/"native/target/replicated-ablation-soak-prerequisite.txt",60)
+    conclusion=capture(["gh","run","view","39551199392","--repo","Tits-McGruff/PyRL-trainer",
+                        "--json","conclusion","--jq",".conclusion"],PYRL)
+    if conclusion!="success":raise RuntimeError("required PyRL checkpoint CI is not successful: "+conclusion)
+    if shutil.disk_usage(SLITHER/"native/target").free<6*1024**3:
+        raise RuntimeError("study/build reserve requires six GiB free")
+    ROOT.mkdir()
+    shutil.copyfile(__file__,ROOT/"run-study.py")
+    journal("building-source-matched-native-runners")
+    run(["cargo","build","--manifest-path","native/Cargo.toml","--release","--features",
+         "engine-test-hooks","--bin","canonical-training-graph","--bin","baseline-v2-qualification","-j","2"],
+        SLITHER,ROOT/"native-build.txt",1800)
+    frozen()
+    canonical=SLITHER/"native/target/release/canonical-training-graph.exe"
+    tactical=SLITHER/"native/target/release/baseline-v2-qualification.exe"
+    journal("collecting-eight-seed-native-corpus")
+    run([tactical,"--seed-count","8","--steps","600","--workers","1","--cadence",
+         "0.016666666666666666","--output",ROOT/"teachers.json","--corpus-directory",ROOT/"corpus"],
+        SLITHER,ROOT/"corpus-log.txt",1800)
+    corpus=json.loads((ROOT/"corpus/corpus.json").read_bytes())
+    if corpus["sourceSha256"]!=SOURCE:raise RuntimeError("corpus native source mismatch")
+    records=[]
+    for seed in [1,2,3]:
+        for fold in [2,4,6]:
+            frozen()
+            directory=ROOT/f"seed-{seed}-fold-{fold}"
+            journal("training-paired-cell",seed=seed,validationSeed=fold,completedCells=len(records))
+            args=[sys.executable,"-B","-m","pyrl_trainer.tactical_ablation_gate","--corpus",ROOT/"corpus",
+                  "--canonical-runner",canonical,"--tactical-runner",tactical,"--directory",directory,
+                  "--device","cpu","--cpu-threads","2","--updates","1000","--seed",seed,
+                  "--validation-seed",fold,"--batch-sequences","32","--sequence-length","64",
+                  "--burn-in","32","--native-steps","600","--native-workers","1","--deadline-seconds","7200"]
+            run(args,PYRL,ROOT/f"seed-{seed}-fold-{fold}.txt",7250)
+            records.append(directory)
+    frozen()
+    journal("verifying-complete-paired-matrix",completedCells=len(records))
+    args=[sys.executable,"-B","-m","pyrl_trainer.ablation_matrix","--updates","1000","--output",ROOT/"matrix.json"]
+    for directory in records:args.extend(["--study",directory])
+    for seed in [1,2,3]:args.extend(["--initialization-seed",seed])
+    for fold in [2,4,6]:args.extend(["--validation-seed",fold])
+    run(args,PYRL,ROOT/"matrix-log.txt",300)
+    report=json.loads((ROOT/"matrix.json").read_bytes())
+    if not report["replicatedSeedFoldCoverage"] or report["cellCount"]!=9:
+        raise RuntimeError("incomplete replicated matrix")
+    journal("measured",completedCells=9,matrixSha256=hashlib.sha256((ROOT/"matrix.json").read_bytes()).hexdigest(),
+            releaseQualified=False,maturityQualified=False)
+except Exception as error:
+    journal("failed",error=type(error).__name__+": "+str(error)[:2000])
+    raise
