+/// Disposable sampled instrumentation, compiled only into this qualification experiment.
+#[cfg(feature = "engine-test-hooks")]
+pub mod profiling {
+    use std::cell::Cell;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::sync::OnceLock;
+    use std::time::Instant;
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    static SAMPLES: AtomicU64 = AtomicU64::new(0);
+    static NANOS: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+    thread_local! {static ORDINAL: Cell<u64> = const {Cell::new(0)};}
+    pub struct Sample {
+        last: Option<Instant>,
+        nanos: [u64; 8],
+    }
+    fn enabled() -> bool {
+        *ENABLED.get_or_init(|| std::env::var("SLITHER_V4_PROFILE").as_deref() == Ok("1"))
+    }
+    impl Sample {
+        pub fn start() -> Self {
+            let selected = enabled()
+                && ORDINAL.with(|value| {
+                    let old = value.get();
+                    value.set(old.wrapping_add(1));
+                    old % 64 == 0
+                });
+            Self {
+                last: selected.then(Instant::now),
+                nanos: [0; 8],
+            }
+        }
+        pub fn lap(&mut self, phase: usize) {
+            if let Some(last) = &mut self.last {
+                let now = Instant::now();
+                self.nanos[phase] =
+                    u64::try_from(now.duration_since(*last).as_nanos()).unwrap_or(u64::MAX);
+                *last = now;
+            }
+        }
+        pub fn finish(self) {
+            if self.last.is_some() {
+                for (target, value) in NANOS.iter().zip(self.nanos) {
+                    target.fetch_add(value, Ordering::Relaxed);
+                }
+                SAMPLES.fetch_add(1, Ordering::Relaxed);
+            }
+        }
+    }
+    pub fn reset() {
+        if enabled() {
+            SAMPLES.store(0, Ordering::Relaxed);
+            for value in &NANOS {
+                value.store(0, Ordering::Relaxed);
+            }
+        }
+    }
+    pub fn summary() -> Option<serde_json::Value> {
+        enabled().then(|| serde_json::json!({
+            "version":1,"sampling":"every 64th evaluation per native thread; measured interval only",
+            "samples":SAMPLES.load(Ordering::Relaxed),
+            "phaseNames":["setup","pelletQuery","pelletEncoding","bodyQuery","bodyEncoding","raysAndRingEncoding","heads","headEncodingAndValidation"],
+            "nanoseconds":NANOS.iter().map(|value|value.load(Ordering::Relaxed)).collect::<Vec<_>>(),
+        }))
+    }
+}
