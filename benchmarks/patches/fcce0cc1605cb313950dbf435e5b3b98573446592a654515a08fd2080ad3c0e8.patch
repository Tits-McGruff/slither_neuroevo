+/// The exact legacy (signed distance-order key, 64-bit pellet ordinal) tuple.
+/// Unsigned bias preserves signed key order; both original fields are reversible.
+/// A single primitive key lets sort/heap comparisons avoid chained Ordering values.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+struct PelletCandidate(u128);
+
+impl PelletCandidate {
+    fn new(pellet: usize, distance_squared: f64) -> Self {
+        Self::from_order_key(pellet, DistanceOrderKey::new(distance_squared))
+    }
+
+    fn from_order_key(pellet: usize, distance: DistanceOrderKey) -> Self {
+        let ordered = distance.0 as u64 ^ (1 << 63);
+        Self(((ordered as u128) << 64) | pellet as u128)
+    }
+
+    fn pellet(self) -> usize {
+        self.0 as u64 as usize
+    }
+
+    fn distance_squared(self) -> f64 {
+        DistanceOrderKey(((self.0 >> 64) as u64 ^ (1 << 63)) as i64).value()
+    }
 }
 
