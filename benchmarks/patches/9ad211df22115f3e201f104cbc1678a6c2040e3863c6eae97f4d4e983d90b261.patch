+"""Run the qualified paired learning-curve study from two immutable detached checkouts."""
+from pathlib import Path
+import hashlib
+import json
+import os
+import shutil
+import signal
+import subprocess
+import sys
+import time
+
+BASE = Path(__file__).resolve().parents[2]
+WORKSPACES = BASE.parent / ".qualification-workspaces"
+NATIVE = WORKSPACES / "slither-sensors-e867"
+TRAINER = WORKSPACES / "pyrl-cuda-window-9107"
+ROOT = BASE / "native/target/heldout-curve-matrix-cuda-compiled-8000-20261022"
+JOURNAL = BASE / "native/target/heldout-curve-matrix-cuda-compiled-8000-20261022.status.json"
+NATIVE_COMMIT = "e8673ff9dd05926f497c73fdc36de5160ed9e51d"
+TRAINER_COMMIT = "9107b851953de90e2d6a2f3d6612973fd475084a"
+SOURCE = "b2828e0390c51138627616d705ba7f59369ee73c39115e17031426bf52d32b8d"
+TRAINER_FILES = {'canonical_graph.py': '72a80c648ff8058377aaf65f1870b29d9ca20f05e41e9f6a9513574272eb3129', 'sensor_contract.py': '770dff09d17e5be62e07eaa25900deba159f767da567ec0623bbeb29fd63f5a9', 'sequence_distillation.py': '6f434d655ca69c8fef07f45e94dca48cbfd7bc3e0cd830d54d0c205835e12d54', 'distillation_transport.py': '0498343d66408ddc1896ffad48777859e3ddac98406885ab25aaa4518f61d0ce', 'distillation_client.py': '91de1bb80cb00ed961758d079a051c662e3c2ae538a546b11731ba00f39b54c6', 'distillation_storage.py': '05fe9f442c004e6a5c131e44d92b7a285293b7738f28736de07a3519db005f96', 'distillation_replay.py': '4538ca541528c6f550afb41ed3eaa4ff6f0e7640f0f9deb19ac95e3ca7bb85f6', 'distillation_sampling.py': '5eef4b95bccb0e84090053b64fb415e72986da97f255ef0cd83b1222b67626ac', 'distillation_job.py': 'ea5c9657618089983f6ebd03501413a2f89508ce16902bac2fe330e75b2464ad', 'distillation_checkpoint.py': 'beaa2c7a8cfc43af7bad01e97b2ee502f7e92d3b5548b679e60504627dbac9ae', 'distillation_run.py': '0bcb7f639b84458b6dca236cead2bc0774530b096e574a3b42771337d20e8275', 'brain_artifact.py': '667cb3d9d00402a5cd0aa7980094ab1ec0306b4f561fc814aa76d17c02ea2e74', 'distillation_shadows.py': '6663d2edbecf8c8ce6e36dc46382e9de28a4ad184750e6a19c8b4dd2171f5277', 'canonical_parity.py': 'b960733610b12a33d894f080d54473531b7b3e0d7ce665b58d5e08d0febacc30', 'tactical_corpus.py': '2ce401f7606333c07ac835ea481cbc853b032c26ba3d3031ebb9ea207463e1ce', 'tactical_ablation.py': '4d252a5317417cc98c23aeaa909c52c03a3fe01bc04a30add9003f590b210506', 'tactical_ablation_gate.py': '19437ed0725e3f9cf4835d8f610c14f65cac8e669f424c5cdfceb4349c85982f', 'tactical_contract.py': 'b0ff47fc364f8caaf3b7c6ff0a4dc74bec5e5811d420fd8befa3ff77c9c43390'}
+TRAINER_SOURCE = "55cfbb12ddbad5780e8185beb53e51793b3ba0e99af0b7225ab18ecb1fbd2d4d"
+STARTED = time.monotonic()
+DEADLINE = STARTED + 20 * 3600
+FLAGS = subprocess.CREATE_NO_WINDOW if os.name == "nt" else 0
+
+
+def need(condition, message):
+    """Keep study identity and resource checks active under any interpreter optimization."""
+    if not condition:
+        raise RuntimeError(message)
+
+
+def sha(path):
+    """Stream immutable runner or report identity."""
+    value = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            value.update(block)
+    return value.hexdigest()
+
+
+def journal(stage, **fields):
+    """Retain bounded task status; final artifacts, not this file alone, establish completion."""
+    value = {"schemaVersion": 1, "stage": stage, "driverPid": os.getpid(),
+             "nativeCommit": NATIVE_COMMIT, "trainerCommit": TRAINER_COMMIT,
+             "nativeSourceSha256": SOURCE, "device": "cuda:0", "updatesPerVariant": 8000, "cudaGraphs": True, "elapsedSeconds": time.monotonic() - STARTED,
+             **fields}
+    with JOURNAL.open("w", encoding="utf-8") as stream:
+        stream.write(json.dumps(value, indent=2) + "\n")
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+def capture(arguments, cwd):
+    """Read compact trusted tool output without shell interpolation."""
+    return subprocess.check_output(arguments, cwd=cwd, text=True, creationflags=FLAGS, timeout=60).strip()
+
+
+def frozen():
+    """Both source trees and copied binaries must remain the qualified immutable versions."""
+    for root, revision in ((NATIVE, NATIVE_COMMIT), (TRAINER, TRAINER_COMMIT)):
+        need(capture(["git", "rev-parse", "HEAD"], root) == revision, "frozen checkout revision changed")
+        need(not capture(["git", "status", "--porcelain"], root), "frozen checkout has uncommitted changes")
+    helper = NATIVE / "server/rustEngine/nativeSourceIdentity.ts"
+    code = ("import {computeNativeSourceIdentity} from " + json.dumps(helper.as_posix())
+            + "; console.log(computeNativeSourceIdentity(" + json.dumps((NATIVE / "native").as_posix())
+            + ").sha256)")
+    identity = capture(["node", str(BASE / "node_modules/tsx/dist/cli.mjs"), "-e", code], NATIVE)
+    need(identity == SOURCE, "frozen native source identity differs")
+    for name, digest in TRAINER_FILES.items():
+        need(sha(TRAINER / "pyrl_trainer" / name) == digest, "frozen trainer bytes changed")
+    current_ci = json.loads(capture(["gh", "run", "view", "39642580899", "--repo",
+                                    "Tits-McGruff/PyRL-trainer", "--json", "conclusion"], TRAINER))
+    need(current_ci["conclusion"] in ("", "success"), "new CUDA checkpoint CI requires investigation")
+    for name, path in RUNNERS.items():
+        need(sha(path) == RUNNER_HASHES[name], "frozen native executable changed")
+
+
+def run(arguments, cwd, log, maximum):
+    """Wait on one owned child with a total deadline; terminate its owned process tree on timeout."""
+    remaining = DEADLINE - time.monotonic()
+    need(remaining > 0, "bounded CUDA study deadline")
+    with log.open("w", encoding="utf-8") as stream:
+        process = subprocess.Popen([str(value) for value in arguments], cwd=cwd,
+                                   stdout=stream, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
+                                   creationflags=FLAGS, start_new_session=os.name != "nt")
+        try:
+            code = process.wait(timeout=min(maximum, remaining))
+        except subprocess.TimeoutExpired:
+            if process.poll() is None:
+                if os.name == "nt":
+                    subprocess.run(["taskkill", "/PID", str(process.pid), "/T", "/F"],
+                                   stdout=stream, stderr=subprocess.STDOUT, check=False,
+                                   timeout=30, creationflags=FLAGS)
+                else:
+                    os.killpg(process.pid, signal.SIGKILL)
+                process.wait(timeout=30)
+            raise
+    need(code == 0, "study child failed; inspect " + log.name)
+
+
+suffix = ".exe" if os.name == "nt" else ""
+RUNNERS = {name: NATIVE / "native/target/release" / (filename + suffix) for name, filename in
+           (("canonical", "canonical-training-graph"), ("tactical", "baseline-v2-qualification"))}
+RUNNER_HASHES = {name: sha(path) for name, path in RUNNERS.items()}
+try:
+    frozen()
+    ci = json.loads(capture(["gh", "run", "view", "39628170062", "--repo", "Tits-McGruff/PyRL-trainer",
+                             "--json", "status,conclusion"], TRAINER))
+    need(ci["conclusion"] == "success", "required held-out curve checkpoint CI is not successful")
+    need(shutil.disk_usage(BASE / "native/target").free >= 6 * 1024**3,
+         "study must preserve six GiB build/evidence reserve")
+    probe_code = ("import json,torch; from pathlib import Path; "
+                  "import pyrl_trainer.sequence_distillation as sequence; "
+                  "from pyrl_trainer.distillation_job import trainer_source_sha256; "
+                  "assert Path(sequence.__file__).resolve().parents[1] == Path.cwd().resolve(); "
+                  "assert trainer_source_sha256() == " + repr(TRAINER_SOURCE) + "; "
+                  "ok=torch.cuda.is_available(); "
+                  "print(json.dumps({'available':ok,'torch':torch.__version__,"
+                  "'device':torch.cuda.get_device_name(0) if ok else None,"
+                  "'freeBytes':torch.cuda.mem_get_info(0)[0] if ok else 0}))")
+    probe = json.loads(capture([sys.executable, "-B", "-c", probe_code], TRAINER))
+    need(probe["available"] and probe["torch"] == "2.14.0+cu126", "qualified CUDA build/device required")
+    need(probe["freeBytes"] >= 8192 * 1024**2, "eight-GiB device budget is not currently admitted")
+    ROOT.mkdir()
+    shutil.copyfile(__file__, ROOT / "run-study.py")
+    journal("collecting-eight-seed-native-corpus", runnerSha256=RUNNER_HASHES, cudaProbe=probe)
+    run([RUNNERS["tactical"], "--seed-count", "8", "--steps", "600", "--workers", "1",
+         "--cadence", "0.016666666666666666", "--output", ROOT / "teachers.json",
+         "--corpus-directory", ROOT / "corpus"], NATIVE, ROOT / "corpus-log.txt", 1800)
+    corpus = json.loads((ROOT / "corpus/corpus.json").read_bytes())
+    need(corpus["sourceSha256"] == SOURCE, "fresh corpus native source differs")
+    directories = []
+    for seed in (1, 2, 3):
+        for fold in (2, 4, 6):
+            frozen()
+            directory = ROOT / f"seed-{seed}-fold-{fold}"
+            journal("training-paired-cell", seed=seed, validationSeed=fold, completedCells=len(directories))
+            budget = min(7200, int(DEADLINE - time.monotonic()) - 60)
+            need(budget >= 60, "insufficient bounded cell time remains")
+            arguments = [sys.executable, "-B", "-m", "pyrl_trainer.tactical_ablation_gate",
+                         "--corpus", ROOT / "corpus", "--canonical-runner", RUNNERS["canonical"],
+                         "--tactical-runner", RUNNERS["tactical"], "--directory", directory,
+                         "--device", "cuda:0", "--cuda-graphs", "--cpu-threads", "2", "--updates", "8000",
+                         "--seed", seed, "--validation-seed", fold, "--batch-sequences", "32",
+                         "--sequence-length", "64", "--burn-in", "32", "--native-steps", "600",
+                         "--native-workers", "1", "--deadline-seconds", budget]
+            for update in (250, 500, 1000, 1500, 2000, 4000, 6000):
+                arguments.extend(["--validation-update", update])
+            run(arguments, TRAINER, ROOT / f"seed-{seed}-fold-{fold}.txt", budget + 30)
+            receipt = json.loads((directory / "summary.json").read_bytes())
+            need(receipt["environment"]["device"] == "cuda:0" and receipt["measurementComplete"]
+                 and len(receipt["variants"]) == 7, "complete actual CUDA cell required")
+            for variant in receipt["variants"]:
+                dispatch = variant["training"]["windowExecution"]
+                need(dispatch["compiledWindowCalls"] == 8000 and dispatch["eagerWindowCalls"] == 0,
+                     "all measured default windows must use bounded CUDA compilation")
+            directories.append(directory)
+    frozen()
+    journal("verifying-complete-paired-matrix", completedCells=len(directories))
+    arguments = [sys.executable, "-B", "-m", "pyrl_trainer.ablation_matrix",
+                 "--updates", "8000", "--output", ROOT / "matrix.json"]
+    for directory in directories:
+        arguments.extend(["--study", directory])
+    for seed in (1, 2, 3):
+        arguments.extend(["--initialization-seed", seed])
+    for fold in (2, 4, 6):
+        arguments.extend(["--validation-seed", fold])
+    run(arguments, TRAINER, ROOT / "matrix-log.txt", 300)
+    matrix = json.loads((ROOT / "matrix.json").read_bytes())
+    need(matrix["cellCount"] == 9 and matrix["replicatedSeedFoldCoverage"], "incomplete paired matrix")
+    for variant in matrix["variants"].values():
+        need([point["update"] for point in variant["heldOutLearningCurve"]]
+             == [0, 250, 500, 1000, 1500, 2000, 4000, 6000, 8000], "incomplete held-out learning curve")
+    journal("measured", completedCells=9, matrixSha256=sha(ROOT / "matrix.json"),
+            releaseQualified=False, maturityQualified=False)
+except Exception as error:
+    journal("failed", error=type(error).__name__ + ": " + str(error)[:2000])
+    raise
