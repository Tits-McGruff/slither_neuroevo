+    #[test]
+    fn independent_pellet_bins_preserve_exact_nearest_prefix_ties_and_capacity() {
+        let mut world = WorldState::default();
+        for ordinal in 0..4096 {
+            world.pellets.push(PelletState {
+                // Duplicate IDs and coincident positions exercise canonical source ties.
+                id: (4096 - ordinal) as u64 / 3 + 1,
+                position: WorldPoint {
+                    x: ((ordinal * 7919 % 71) as f64 - 35.0) * 10.0,
+                    y: ((ordinal * 1877 % 71) as f64 - 35.0) * 10.0,
+                },
+                value: [0.1, 1.0, 6.0][ordinal % 3],
+                kind: 0,
+                color: 0,
+                owner: None,
+            });
+        }
+        let index = PelletSpatialIndex::build(&world, 120.0, 4096).unwrap();
+        let center = WorldPoint { x: 0.0, y: 0.0 };
+        let mut reference = PelletQueryScratch::default();
+        let mut scratch = PelletQueryScratch::default();
+        let original = world.clone();
+        for bins in [1, 8, 16, 31, 32] {
+            let classify = |pellet: &IndexedPellet| pellet.source_index % bins;
+            for limit in [0, 1, 127, 128, 129, 900, 3000, 5000] {
+                let expected_query = index
+                    .collect_sensor_candidates(center, 500.0, limit, &mut reference)
+                    .unwrap();
+                let mut expected = vec![Vec::new(); bins];
+                for pellet in index.candidates(&reference) {
+                    expected[classify(pellet)].push(pellet.source_index);
+                }
+                for _ in 0..2 {
+                    let actual_query = index
+                        .collect_sensor_candidates_unordered(center, 500.0, limit, &mut scratch)
+                        .unwrap();
+                    assert_eq!(actual_query, expected_query);
+                    let capacity = scratch.candidate_capacity();
+                    let mut actual = vec![Vec::new(); bins];
+                    index
+                        .visit_sensor_candidates_by_bin(
+                            &mut scratch,
+                            bins,
+                            classify,
+                            |bin, pellet| {
+                                actual[bin].push(pellet.source_index);
+                            },
+                        )
+                        .unwrap();
+                    assert_eq!(actual, expected, "bins={bins}, limit={limit}");
+                    assert_eq!(scratch.candidate_capacity(), capacity);
+                    // Temporary tags never escape to ordinary record access.
+                    assert_eq!(index.candidates(&scratch).count(), actual_query.candidates);
+                }
+            }
+        }
+        index
+            .collect_sensor_candidates_unordered(center, 500.0, 900, &mut scratch)
+            .unwrap();
+        let original_candidates = scratch.candidates.clone();
+        assert!(index
+            .visit_sensor_candidates_by_bin(&mut scratch, 0, |_| 0, |_, _| {})
+            .is_err());
+        assert_eq!(scratch.candidates, original_candidates);
+        // A classifier error also restores earlier tags before returning.
+        let bad = |pellet: &IndexedPellet| {
+            if pellet.source_index == index.pellets[original_candidates[42].pellet].source_index {
+                32
+            } else {
+                7
+            }
+        };
+        assert!(index
+            .visit_sensor_candidates_by_bin(&mut scratch, 32, bad, |_, _| {})
+            .is_err());
+        assert_eq!(scratch.candidates, original_candidates);
+        assert_eq!(world, original);
+        assert_eq!(size_of::<PelletCandidate>(), 16);
     }
 
