+    /// Visit each independent bin in its exact distance/identity accumulation order.
+    /// The retained set and query work are unchanged. Five temporary high index bits
+    /// provide in-place bucket tags; no candidate, scratch owner or admission grows.
+    /// A defensive oversized-index fallback preserves the ordinary global sort.
+    pub(crate) fn visit_sensor_candidates_by_bin(
+        &self,
+        scratch: &mut PelletQueryScratch,
+        bins: usize,
+        classify: impl Fn(&IndexedPellet) -> usize,
+        mut consume: impl FnMut(usize, &IndexedPellet),
+    ) -> Result<(), SpatialIndexError> {
+        if !(1..=32).contains(&bins) {
+            return Err(SpatialIndexError::InvalidScalar {
+                field: "pellet bin count",
+            });
+        }
+        const SHIFT: u32 = usize::BITS - 5;
+        const INDEX_MASK: usize = usize::MAX >> 5;
+        let values = &mut scratch.candidates;
+        if values.len() < 128 || self.pellets.len() > INDEX_MASK {
+            values.sort_unstable_by(compare_pellet_candidates);
+            for candidate in values {
+                let pellet = &self.pellets[candidate.pellet];
+                let bin = classify(pellet);
+                if bin >= bins {
+                    return Err(SpatialIndexError::InvalidScalar {
+                        field: "pellet bin index",
+                    });
+                }
+                consume(bin, pellet);
+            }
+            return Ok(());
+        }
+        let mut counts = [0usize; 32];
+        for ordinal in 0..values.len() {
+            let bin = classify(&self.pellets[values[ordinal].pellet]);
+            if bin >= bins {
+                for candidate in &mut values[..ordinal] {
+                    candidate.pellet &= INDEX_MASK;
+                }
+                return Err(SpatialIndexError::InvalidScalar {
+                    field: "pellet bin index",
+                });
+            }
+            counts[bin] += 1;
+            values[ordinal].pellet |= bin << SHIFT;
+        }
+        let mut next = [0usize; 32];
+        let mut end = [0usize; 32];
+        let mut start = 0;
+        for bin in 0..bins {
+            next[bin] = start;
+            start += counts[bin];
+            end[bin] = start;
+        }
+        start = 0;
+        for bin in 0..bins {
+            while next[bin] < end[bin] {
+                let target = values[next[bin]].pellet >> SHIFT;
+                if target == bin {
+                    next[bin] += 1;
+                } else {
+                    values.swap(next[bin], next[target]);
+                    next[target] += 1;
+                }
+            }
+            let ordered = &mut values[start..end[bin]];
+            ordered.sort_unstable_by(compare_pellet_candidates);
+            for candidate in ordered {
+                candidate.pellet &= INDEX_MASK;
+                consume(bin, &self.pellets[candidate.pellet]);
+            }
+            start = end[bin];
+        }
+        Ok(())
     }
 
