[Unit]
Description=Slither Neuroevolution Rust-authoritative server
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=-@REPO_ROOT@/server/systemd.env
ExecStart=@REPO_ROOT@/scripts/run-production.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=default.target
