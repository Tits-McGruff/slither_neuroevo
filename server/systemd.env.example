# Copy to server/systemd.env only when the service needs an explicit override.
# Normal deployment settings come from server/config.toml.
# Uncomment individual values here to override that TOML for the systemd service.

# Use 0.0.0.0 only for deliberate access from the owner's trusted home LAN.
# SLITHER_HOST=0.0.0.0
# SLITHER_PORT=5174
# SLITHER_DB_PATH=./data/slither.db

# Optional startup override. With neither variable set, the TOML `resume` value applies.
# SLITHER_START_MODE=fresh
# SLITHER_START_MODE=resume
# SLITHER_RESUME_TARGET=latest

# Optional when a browser must use a specific LAN address.
# PUBLIC_WS_URL=ws://192.168.1.10:5174

# Optional calculation worker override. The checked-in default is five.
# RUST_WORKERS=5